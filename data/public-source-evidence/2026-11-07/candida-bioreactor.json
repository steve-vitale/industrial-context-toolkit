{"created": "2026-04-28T12:29:30.268880+00:00", "modified": "2026-04-28T12:29:31.046501+00:00", "id": 19854128, "conceptrecid": "19853217", "doi": "10.5281/zenodo.19854128", "conceptdoi": "10.5281/zenodo.19853217", "doi_url": "https://doi.org/10.5281/zenodo.19854128", "metadata": {"title": "Experimental dataset on mutant generation, amino acid inhibitor-based screening, and process optimization for enhanced protein and essential amino acid production in Candida utilis", "doi": "10.5281/zenodo.19854128", "publication_date": "2026-04-28", "description": "<p>This dataset contains experimental results from shake-flask and bioreactor cultivation of Candida utilis for the production of protein-rich biomass. The study includes medium optimization, mutagenesis, and screening of mutant strains with improved protein synthesis.<br>The dataset comprises results from media screening experiments with different carbon and nitrogen sources, as well as Response Surface Methodology (RSM) designs used to evaluate the effect of medium composition on biomass yield and protein production. Mutants were generated using EMS treatment, screened in the presence of amino acid inhibitors, and evaluated for performance in shake flasks.<br>The best-performing mutant and optimized medium were validated in batch fermentation in a 5 L stirred bioreactor under controlled conditions.<br>The dataset includes biomass concentration, protein content, protein yield, and, where applicable, amino acid composition, along with information on medium composition, cultivation conditions, and process parameters.</p>", "access_right": "open", "creators": [{"name": "Palcevska, Jelizaveta", "affiliation": "Riga Technical University", "orcid": "0009-0006-9489-7235"}, {"name": "Raita, Svetlana", "affiliation": "Riga Technical University", "orcid": "0000-0003-1899-9687"}, {"name": "Kusnere, Zane", "affiliation": "Riga Technical University", "orcid": "0000-0002-0596-5413"}, {"name": "Geiba, Zane", "affiliation": "Riga Technical University", "orcid": "0009-0007-6157-6897"}], "resource_type": {"title": "Dataset", "type": "dataset"}, "license": {"id": "cc-by-4.0"}, "grants": [{"code": "lzp-2022/1-0126", "internal_id": "02ar66p97::lzp-2022/1-0126", "funder": {"name": "Latvian Council of Science"}, "title": "Herbicides as tool for selection of edible protein-rich mutants", "url": "https://videszinatne.rtu.lv/en/science/project-and-research/herbicides-as-tool-for-selection-of-edible-protein-rich-mutants/"}], "relations": {"version": [{"index": 2, "is_last": false, "parent": {"pid_type": "recid", "pid_value": "19853217"}}]}}, "title": "Experimental dataset on mutant generation, amino acid inhibitor-based screening, and process optimization for enhanced protein and essential amino acid production in Candida utilis", "links": {"self": "https://zenodo.org/api/records/19854128", "self_html": "https://zenodo.org/records/19854128", "preview_html": "https://zenodo.org/records/19854128?preview=1", "doi": "https://doi.org/10.5281/zenodo.19854128", "self_doi": "https://doi.org/10.5281/zenodo.19854128", "self_doi_html": "https://zenodo.org/doi/10.5281/zenodo.19854128", "reserve_doi": "https://zenodo.org/api/records/19854128/draft/pids/doi", "parent": "https://zenodo.org/api/records/19853217", "parent_html": "https://zenodo.org/records/19853217", "parent_doi": "https://doi.org/10.5281/zenodo.19853217", "parent_doi_html": "https://zenodo.org/doi/10.5281/zenodo.19853217", "self_iiif_manifest": "https://zenodo.org/api/iiif/record:19854128/manifest", "self_iiif_sequence": "https://zenodo.org/api/iiif/record:19854128/sequence/default", "files": "https://zenodo.org/api/records/19854128/files", "media_files": "https://zenodo.org/api/records/19854128/media-files", "thumbnails": {"10": "https://zenodo.org/api/iiif/record:19854128:Candida_utilis_dataset-description%20(1).pdf/full/%5E10,/0/default.jpg", "50": "https://zenodo.org/api/iiif/record:19854128:Candida_utilis_dataset-description%20(1).pdf/full/%5E50,/0