{
 "format": "context-map-classes-1",
 "format_version": "1.2.0-draft",
 "note": "The small class tree of context-map-1 (since 1.1). Definitions are this project's own words. DEXPI class names and their class-page URLs were opened on 2026-11-04 (DEXPI 2.0.1); DEXPI publishes HTML class pages, not an RDF namespace, so the URLs are documentation links used as IRIs. CFIHOS tag class codes are not looked up (to_confirm). A class asserts nothing on its own: the inference rules below say when a tag or a datasheet value deterministically gives a class; anything else stays unset.",
 "attribution": "DEXPI Specification 2.0.1, DEXPI Initiative, CC BY 4.0; class names and page URLs only.",
 "certification_rule": "Only a certified class is assigned by inference or used to check relations. The shipped classes are certified as format vocabulary by its maintainers; that certifies the word, never that a given item belongs to it (an inferred class stays unverified). A site's own added classes start as draft.",
 "kind_roots": {
  "equipment": [
   "equipment",
   "valve"
  ],
  "final_element": [
   "valve"
  ],
  "manual_valve": [
   "valve"
  ],
  "relief_device": [
   "valve"
  ],
  "instrument": [
   "instrument"
  ],
  "controller": [
   "instrument"
  ],
  "line": [
   "line"
  ]
 },
 "letter_rules_note": "ISA-5.1 succeeding letters by a short rule of our own (the standard's letter tables are not reproduced). Letters are the tag's leading letters (FIT-2203 -> FIT). The first matching rule wins; a class outside the roots allowed for the item's kind is not assigned. Plant-coded letters belong in the site's letter overrides.",
 "letter_rules": [
  {
   "pattern": "^[A-Z]S[VE]$|^[A-Z]RV$",
   "class": "relief_device",
   "note": "PSV, TSV, PRV, PSE (rupture disc)"
  },
  {
   "pattern": "^FDV$",
   "class": "divert_valve",
   "plant_coded": true,
   "note": "flow diversion valve; plant-coded but near universal on dairy pasteurizers"
  },
  {
   "pattern": "^[A-Z]?XV$",
   "class": "on_off_valve",
   "note": "XV, FXV"
  },
  {
   "pattern": "^HV$",
   "class": "manual_valve"
  },
  {
   "pattern": "^[A-Z]C?V$",
   "class": "control_valve",
   "note": "FV, TV, PV, LV, FCV, TCV, PCV, LCV"
  },
  {
   "pattern": "^[A-Z]D?I?C$",
   "class": "controller",
   "note": "FC, TIC, PDIC"
  },
  {
   "pattern": "^[A-Z]D?I?T$",
   "class": "transmitter",
   "note": "TT, PT, FIT, PDT"
  },
  {
   "pattern": "^[A-Z]D?E$",
   "class": "primary_element",
   "note": "TE, FE"
  },
  {
   "pattern": "^[A-Z]D?S[HL]{0,2}$",
   "class": "switch",
   "note": "PS, LSL, PSH"
  },
  {
   "pattern": "^[A-Z]D?I$",
   "class": "indicator",
   "note": "TI, PI, PDI"
  },
  {
   "pattern": "^[A-Z]D?Y$",
   "class": "relay_compute",
   "note": "FY, TY"
  }
 ],
 "equipment_prefixes_note": "Equipment tag prefixes are site conventions, not a standard. These common ones apply only to items whose kind is equipment and whose letters no letter rule matched; a site replaces them with its own (equipment_prefixes in the site file).",
 "equipment_prefixes": {
  "P": "pump",
  "HT": "hold_tube",
  "PHE": "plate_heat_exchanger",
  "E": "heat_exchanger",
  "HX": "heat_exchanger",
  "TK": "tank",
  "T": "tank",
  "V": "vessel"
 },
